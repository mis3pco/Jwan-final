rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid}/{allPaths=**} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('(image/.*|application/pdf)');
    }
    match /receipts/{uid}/{allPaths=**} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('(image/.*|application/pdf)');
    }
  }
}
